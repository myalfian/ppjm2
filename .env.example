# Copy this file to .env for local development and fill in values from your provider.
# Never commit real credentials or API keys to Git.
SUPABASE_ANON_KEY=replace-with-supabase-anon-public-key
SUPABASE_URL=https://your-project-ref.supabase.co
GOOGLE_MAPS_API_KEY=replace-with-google-maps-browser-key-optional
